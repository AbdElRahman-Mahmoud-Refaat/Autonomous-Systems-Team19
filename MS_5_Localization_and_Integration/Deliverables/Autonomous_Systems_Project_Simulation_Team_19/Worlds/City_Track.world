<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="city_track_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= CITY TRACK ROAD ================= -->
    <!-- Outer dimensions about 5 m x 4 m, track width about 0.5 m -->

    <!-- Bottom straight road -->
    <model name="bottom_road">
      <static>true</static>
      <pose>0 -2.02 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.0 0.96 0.04</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Top straight road -->
    <model name="top_road">
      <static>true</static>
      <pose>0 2.02 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.0 0.96 0.04</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Left straight road -->
    <model name="left_road">
      <static>true</static>
      <pose>-2.52 0 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.96 5.0 0.04</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
        </visual>
